@startuml
!include puml-theme-pfe.puml

start
:Réception d'une tentative de planification;
note right: (Date, Salle, Horaire, Projet)

fork
  :Vérifier **RG1 : Chevauchement Enseignant**;
  if (Enseignant déjà occupé ?) then (Oui)
    :Ajouter "Erreur : Double affectation enseignant";
  endif
fork again
  :Vérifier **RG2 : Occupation Salle**;
  if (Salle déjà occupée ?) then (Oui)
    :Ajouter "Erreur : Créneau salle occupé";
  endif
fork again
  :Vérifier **RG3 : Limites Session**;
  if (Date hors [Début, Fin] ?) then (Oui)
    :Ajouter "Erreur : Date hors session";
  endif
fork again
  :Vérifier **RG4 : Conflit Encadrant**;
  if (Encadrant déjà sollicité ?) then (Oui)
    :Ajouter "Avertissement : Conflit encadrant";
  endif
fork again
  :Vérifier **RG5 : Double Planification**;
  if (Projet déjà planifié ?) then (Oui)
    :Ajouter "Erreur : Projet déjà affecté";
  endif
fork again
  :Vérifier **RG6 : Indisponibilités**;
  if (Enseignant a déclaré indisponibilité ?) then (Oui)
    :Ajouter "Erreur : Enseignant indisponible";
  endif
end fork

if (Présence d'erreurs critiques ?) then (Oui)
  :Retourner **ÉCHEC** + Liste des conflits;
  :Suggérer résolution intelligente;
else (Non)
  :Retourner **VALIDÉ**;
endif

stop
@enduml
