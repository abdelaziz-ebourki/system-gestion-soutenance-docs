@startuml
!include puml-theme-pfe.puml

start
:Coordinateur initialise les évaluations
pour une soutenance;

repeat
  :Membre du jury saisit individuellement\nsa note (0-20), observation et présence;
  :Soumission via POST /api/teacher/evaluations/\{id\};
backward:Note verrouillée après soumission;
repeat while (Tous les membres ont soumis ?) is (Non)

:Calcul automatique de la moyenne pondérée\n(coefficients par rôle de jury);

stop
@enduml
