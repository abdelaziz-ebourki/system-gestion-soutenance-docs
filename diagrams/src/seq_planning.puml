@startuml
!include puml-theme-pfe.puml

actor "Coordinateur" as Coord
boundary "Defense Designer (React)" as Front
control "Conflict Engine (TS)" as LocalEngine
entity "Schedule Controller (API)" as API
entity "Conflict Service (Java)" as BackendEngine
database "Base de données" as DB

Coord -> Front : Glisser-déposer un Jury sur un créneau
activate Front

Front -> LocalEngine : validateSlotAssignment(projectId, slot, context)
activate LocalEngine
LocalEngine -> LocalEngine : Exécuter les six vérifications (Local)
LocalEngine --> Front : Résultat (isValid, issues)
deactivate LocalEngine

alt Conflit critique détecté
    Front -> Coord : Afficher message d'erreur + Suggestion intelligente
else Valide
    Front -> Front : Mettre à jour l'état local (schedule)
    Front -> Coord : Afficher "Positionné avec succès"
end

Coord -> Front : Cliquer sur "Enregistrer"
Front -> API : POST /api/coordinator/schedule (Full State)
activate API

API -> BackendEngine : validate(request, sessionId)
activate BackendEngine
BackendEngine -> DB : Vérifier intégrité et conflits finaux
DB --> BackendEngine : Données
BackendEngine --> API : Validation OK
deactivate BackendEngine

API -> DB : Persister SlotAssignments
DB --> API : OK
API --> Front : 200 OK (Confirmé)
deactivate API
Front -> Coord : Notification "Planning enregistré"
deactivate Front

@enduml
