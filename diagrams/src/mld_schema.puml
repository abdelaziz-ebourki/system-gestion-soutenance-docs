@startuml
!include puml-theme-pfe.puml

skinparam Linetype ortho

entity "users" as users << (T, #c2ccd7) >> {
  * id : BIGINT (PK)
  --
  dtype : VARCHAR
  email : VARCHAR (U)
  password : VARCHAR
  role : ENUM(ADMIN,COORDINATOR,TEACHER,STUDENT)
  last_name : VARCHAR
  first_name : VARCHAR
  is_active : BOOLEAN
  verification_token : VARCHAR
  reset_token : VARCHAR
  reset_token_expires : TIMESTAMP
}

entity "student" as student << (T, #c2ccd7) >> {
  * id : BIGINT (PK, FK→users)
  --
  cne : VARCHAR
  major_id : BIGINT (FK→major)
  level_id : BIGINT (FK→level)
}

entity "teacher" as teacher << (T, #c2ccd7) >> {
  * id : BIGINT (PK, FK→users)
  --
  grade_id : BIGINT (FK→grade)
  department_id : BIGINT (FK→department)
}

entity "coordinator" as coordinator << (T, #c2ccd7) >> {
  * id : BIGINT (PK, FK→users)
}

entity "defense_session" as defsession << (T, #c2ccd7) >> {
  * id : BIGINT (PK)
  --
  name : VARCHAR
  defense_type : ENUM(PFE,MEMOIRE,THESE)
  status : ENUM(DRAFT,ACTIVE,SCHEDULED,COMPLETED,ARCHIVED)
  max_group_size : INT
  defense_duration : INT
  break_duration : INT
  submission_deadline : DATE
  start_date : DATE
  end_date : DATE
  jury_role_template_id : BIGINT (FK→jury_role_template)
}

entity "defense_session_coefficients" as dscoeffs << (T, #c2ccd7) >> {
  * defense_session_id : BIGINT (PK, FK→defense_session)
  * role_name : VARCHAR (PK)
  --
  coefficient : INT
}

entity "defense" as defense << (T, #c2ccd7) >> {
  * id : BIGINT (PK)
  --
  date : DATE
  time : TIME
  project_id : BIGINT (FK→project, U)
  room_id : BIGINT (FK→room)
}

entity "defense_members" as dmembers << (T, #c2ccd7) >> {
  * defense_id : BIGINT (PK, FK→defense)
  * teacher_id : BIGINT (FK→teacher)
  * role_name : VARCHAR (PK)
}

entity "project" as project << (T, #c2ccd7) >> {
  * id : BIGINT (PK)
  --
  title : VARCHAR
  description : TEXT
  defense_type : VARCHAR
  status : ENUM(PENDING,APPROVED,REJECTED)
  supervisor_id : BIGINT (FK→teacher)
}

entity "project_students" as pstudents << (T, #c2ccd7) >> {
  * project_id : BIGINT (PK, FK→project)
  * student_id : BIGINT (PK, FK→student)
}

entity "coordinator_group" as cgroup << (T, #c2ccd7) >> {
  * id : BIGINT (PK)
  --
  group_name : VARCHAR (U)
  project_id : BIGINT (FK→project)
  session_id : BIGINT
  leader_id : BIGINT
}

entity "group_members" as gmembers << (T, #c2ccd7) >> {
  * group_id : BIGINT (PK, FK→coordinator_group)
  * student_id : BIGINT (PK, FK→student)
}

entity "room" as room << (T, #c2ccd7) >> {
  * id : BIGINT (PK)
  --
  name : VARCHAR
  capacity : INT
  department_id : BIGINT (FK→department)
}

entity "evaluation" as eval << (T, #c2ccd7) >> {
  * id : BIGINT (PK)
  --
  teacher_id : BIGINT
  defense_session_id : BIGINT
  role : VARCHAR
  score : FLOAT
  comment : TEXT
  status : ENUM(PENDING,SUBMITTED)
  submitted_at : TIMESTAMP
  defense_id : BIGINT (FK→defense)
}

entity "unavailability" as unavail << (T, #c2ccd7) >> {
  * id : BIGINT (PK)
  --
  teacher_id : BIGINT
  date : VARCHAR
}

entity "unavailability_slots" as uslots << (T, #c2ccd7) >> {
  * unavailability_id : BIGINT (PK, FK→unavailability)
  * slot : VARCHAR (PK)
}

entity "notification" as notif << (T, #c2ccd7) >> {
  * id : BIGINT (PK)
  --
  type : ENUM(SUCCESS,WARNING,ERROR,INFO,REMINDER)
  title : VARCHAR
  message : TEXT
  timestamp : TIMESTAMP
  read : BOOLEAN
  action_link : VARCHAR
  actor : VARCHAR
}

entity "student_document" as sdoc << (T, #c2ccd7) >> {
  * id : BIGINT (PK)
  --
  student_id : BIGINT
  name : VARCHAR
  type : VARCHAR
  deadline : VARCHAR
  status : VARCHAR
  submitted_at : TIMESTAMP
  file_path : VARCHAR
}

entity "grade" as grade << (T, #c2ccd7) >> {
  * id : BIGINT (PK)
  --
  name : VARCHAR
}

entity "level" as level << (T, #c2ccd7) >> {
  * id : BIGINT (PK)
  --
  name : VARCHAR
}

entity "major" as major << (T, #c2ccd7) >> {
  * id : BIGINT (PK)
  --
  name : VARCHAR
}

entity "department" as dept << (T, #c2ccd7) >> {
  * id : BIGINT (PK)
  --
  name : VARCHAR
  code : VARCHAR
  head_id : BIGINT (FK→teacher)
  faculty_id : BIGINT (FK→faculty)
}

entity "faculty" as faculty << (T, #c2ccd7) >> {
  * id : BIGINT (PK)
  --
  name : VARCHAR
  code : VARCHAR
  dean_id : BIGINT (FK→teacher)
  logo_url : VARCHAR
}

entity "general_settings" as gsettings << (T, #c2ccd7) >> {
  * id : BIGINT (PK)
  --
  institution_name : VARCHAR
  institution_logo_url : VARCHAR
  timezone : VARCHAR
  date_format : VARCHAR
  setup_completed : BOOLEAN
}

entity "email_config" as econfig << (T, #c2ccd7) >> {
  * id : BIGINT (PK)
  --
  host : VARCHAR
  port : INT
  username : VARCHAR
  password : VARCHAR
  sender_name : VARCHAR
  sender_email : VARCHAR
  encryption : VARCHAR
}

entity "document_config" as dconfig << (T, #c2ccd7) >> {
  * id : BIGINT (PK)
  --
  max_file_size_mb : INT
  allowed_extensions : VARCHAR
  version_limit : INT
}

entity "defense_settings" as defsettings << (T, #c2ccd7) >> {
  * id : BIGINT (PK)
  --
  start_time : VARCHAR
  end_time : VARCHAR
  defense_duration : INT
  break_duration : INT
  group_creation_start_date : VARCHAR
  group_creation_end_date : VARCHAR
}

entity "jury_role_template" as jrtemplate << (T, #c2ccd7) >> {
  * id : BIGINT (PK)
  --
  name : VARCHAR (U)
  defense_type : ENUM(PFE,MEMOIRE,THESE)
}

entity "jury_role_template_roles" as jrtroles << (T, #c2ccd7) >> {
  * jury_role_template_id : BIGINT (PK, FK→jury_role_template)
  * name : VARCHAR (PK)
  --
  count : INT
  coefficient : INT
}

entity "audit_log" as audit << (T, #c2ccd7) >> {
  * id : BIGINT (PK)
  --
  action : VARCHAR
  entity : VARCHAR
  entity_id : BIGINT
  performed_by_email : VARCHAR
  details : TEXT
  timestamp : TIMESTAMP
}

users ||--o| student
users ||--o| teacher
users ||--o| coordinator

student }o--|| major
student }o--|| level

teacher }o--|| grade
teacher }o--|| dept

dept }o--|| faculty
faculty ||--o{ teacher : dean
dept ||--o{ teacher : head

room }o--|| dept

project }o--|| teacher : supervisor
project ||--|{ pstudents
student ||--|{ pstudents

cgroup }o--|| project
cgroup ||--|{ gmembers
student ||--|{ gmembers

defense ||--|| project
defense }o--|| room
defense ||--|{ dmembers
teacher ||--o{ dmembers

defsession ||--|{ dscoeffs
defsession }o--|| jrtemplate
jrtemplate ||--|{ jrtroles

defsession ||--o{ cgroup : session_id

eval }o--|| defense

@enduml
