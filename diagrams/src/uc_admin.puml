@startuml
!include puml-theme-pfe.puml
left to right direction

actor "Administrateur" as Admin

rectangle "Module Administration" {
    usecase "Consulter tableau de bord" as Dashboard
    usecase "Gérer les départements" as Depts
    usecase "Gérer les salles" as Rooms
    usecase "Gérer les étudiants" as Students
    usecase "Gérer les enseignants" as Teachers
    usecase "Gérer les coordinateurs" as Coords
    usecase "Configurer les filières" as Majors
    usecase "Configurer les niveaux" as Levels
    usecase "Consulter journaux d'audit" as Audit

    usecase "Importer en masse\n(Excel)" as Import
    usecase "Actions par lots\n(suppression, réaffectation)" as Batch

    Import ..> Students : <<include>>
    Import ..> Teachers : <<include>>
    Import ..> Coords : <<include>>
    Import ..> Rooms : <<include>>
    Batch ..> Students : <<extend>>
    Batch ..> Teachers : <<extend>>
}

Admin --> Dashboard
Admin --> Depts
Admin --> Rooms
Admin --> Students
Admin --> Teachers
Admin --> Coords
Admin --> Majors
Admin --> Levels
Admin --> Audit
Admin --> Import
Admin --> Batch
@enduml
