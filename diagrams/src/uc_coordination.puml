@startuml
!include puml-theme-pfe.puml
left to right direction

actor "Coordinateur" as Coord

rectangle "Gestion des données" {
    usecase "Consulter tableau de bord" as Dashboard
    usecase "Gérer les projets" as Projects
    usecase "Gérer les groupes\nd'étudiants" as Groups
    usecase "Constituer les jurys" as Juries
    usecase "Gérer les sessions\nde soutenance" as Sessions
}

rectangle "Planification" {
    usecase "Planifier les soutenances\n(glisser-déposer)" as Planner
    usecase "Générer automatiquement\nle planning" as AutoGen
    usecase "Publier le planning" as Publish
    usecase "Vérifier les conflits" as Conflicts
    usecase "Consulter les notes\n/ moyennes" as Grades
}

rectangle "Édition documentaire" {
    usecase "Générer fiches\nd'évaluation" as GenFiches
    usecase "Générer listes\nde présence" as GenPres
    usecase "Générer procès-verbaux" as GenPV
    usecase "Générer planning final" as GenPlanning
}

Planner ..> Conflicts : <<include>>
Sessions ..> Planner : <<include>>
AutoGen ..> Conflicts : <<include>>
GenFiches ..> Grades : <<include>>

Coord --> Dashboard
Coord --> Projects
Coord --> Groups
Coord --> Juries
Coord --> Sessions
Coord --> Planner
Coord --> AutoGen
Coord --> Publish
Coord --> Conflicts
Coord --> Grades
Coord --> GenFiches
Coord --> GenPres
Coord --> GenPV
Coord --> GenPlanning
@enduml
