@startuml
!include puml-theme-pfe.puml

actor "Utilisateur" as User
boundary "Print Component (React)" as Front
entity "Browser Engine" as Browser
entity "CSS Styles (@media print)" as CSS

User -> Front : Cliquer sur "Imprimer la convocation"
activate Front

Front -> Front : Charger données de la soutenance
Front -> Browser : Demander l'impression (window.print())
deactivate Front

activate Browser
Browser -> CSS : Appliquer styles d'impression
CSS -> Browser : Masquer UI (Navigation, Buttons)\nForcer format A4 / Marges
Browser -> User : Afficher dialogue d'impression système
User -> Browser : Confirmer "Enregistrer en PDF"
Browser -> User : Générer fichier PDF local
deactivate Browser

@enduml
