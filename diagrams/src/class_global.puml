@startuml
!include puml-theme-pfe.puml
top to bottom direction

' --- Enums ---
enum RoleEnum {
    ADMIN
    COORDINATOR
    TEACHER
    STUDENT
}

enum DefenseSessionStatus {
    DRAFT
    ACTIVE
    SCHEDULED
    COMPLETED
    ARCHIVED
}

enum DefenseType {
    PFE
    MEMOIRE
    THESE
}

enum ProjectStatus {
    PENDING
    APPROVED
    REJECTED
}

enum EvaluationStatus {
    PENDING
    SUBMITTED
}

enum EvaluationAttendanceStatus {
    PRESENT
    ABSENT
    DEFAILLANT
}

enum NotificationType {
    SUCCESS
    WARNING
    ERROR
    INFO
    REMINDER
}

User -[hidden]up- EvaluationStatus 

' --- User Hierarchy ---
together {
abstract class User {
    + Long id
    + String email
    + String password
    + RoleEnum role
    + String firstName
    + String lastName
    + Boolean isActive
    + String verificationToken
    + String resetToken
    + LocalDateTime resetTokenExpires
    + seConnecter()
    + seDeconnecter()
    + modifierProfil()
} 

class Teacher {
    + TeacherRank teacherRank
    + Department department
}

class Student {
    + String cne
    + String codeApogee
    + Major major
    + Level level
}

class Coordinator {
}

User <|-- Teacher
User <|-- Student
User <|-- Coordinator

' --- Core Entities ---

class Faculty {
    + Long id
    + String name
    + String code
    + Teacher dean
    + String logoUrl
}

class Department {
    + Long id
    + String name
    + String code
    + Teacher head
    + Faculty faculty
}

class Major {
    + Long id
    + String name
    + Department department
}

class Level {
    + Long id
    + String name
}

class TeacherRank {
    + Long id
    + String name
}

class DefenseSession {
    + Long id
    + String name
    + DefenseType defenseType
    + DefenseSessionStatus status
    + Integer maxGroupSize
    + Integer defenseDuration
    + Integer breakDuration
    + LocalDate submissionDeadline
    + Map<String, Integer> evaluationCoefficients
    + JuryRoleTemplate juryRoleTemplate
    + LocalDate startDate
    + LocalDate endDate
    + Boolean isFrozen
    + Long approvedBy
    + LocalDateTime approvedAt
}

class Defense {
    + Long id
    + LocalDate date
    + LocalTime time
    + Room room
    + List<JuryMember> members
}

class Project {
    + Long id
    + String title
    + String description
    + DefenseType defenseType
    + ProjectStatus status
    + Teacher supervisor
}

class Room {
    + Long id
    + String name
    + Integer capacity
    + Department department
}

class Evaluation {
    + Long id
    + Long teacherId
    + Long defenseSessionId
    + Defense defense
    + String role
    + Double score
    + String comment
    + EvaluationStatus status
    + LocalDateTime submittedAt
    + EvaluationAttendanceStatus attendanceStatus
}

class Unavailability {
    + Long id
    + Long teacherId
    + String date
    + List<String> slots
}

class AppNotification {
    + Long id
    + NotificationType type
    + String title
    + String message
    + LocalDateTime timestamp
    + Boolean read
    + String actionLink
    + String actor
}

class StudentDocument {
    + Long id
    + Long studentId
    + String name
    + String type
    + String deadline
    + String status
    + LocalDateTime submittedAt
    + String filePath
}

class StudentGroup {
    + Long id
    + String groupName
    + Project project
    + List<Student> students
    + Long sessionId
    + Long leaderId
}

class JuryRoleTemplate {
    + Long id
    + String name
    + DefenseType defenseType
    + List<TemplateRole> roles
}

class TemplateRole <<Embeddable>> {
    + String name
    + Integer count
    + Integer coefficient
}

class AuditLog {
    + Long id
    + String action
    + String entity
    + Long entityId
    + String performedByEmail
    + String details
    + LocalDateTime timestamp
}
}

' --- Relationships ---

Faculty "1" -- "0..*" Department : contient >
Faculty "1" -- "1" Teacher : décanat (dean) >
Department "1" -- "0..*" Major : propose >
Department "1" -- "1" Teacher : direction (head) >
Department "1" -- "0..*" Room : gère >
Teacher "0..*" -- "1" TeacherRank : grade >
Teacher "0..*" -- "1" Department : affecté à >
Teacher "1" -- "0..*" Project : encadre (supervisor) >

Student "0..*" -- "1" Major : spécialité >
Student "0..*" -- "1" Level : niveau >
Project "0..*" -- "0..*" Student : membres >
Project "1" -- "0..1" Defense : planification >
Defense "0..*" -- "1" Room : lieu >
Defense "1" -- "0..*" Evaluation : reçoit >

DefenseSession "1" -- "0..*" Defense : regroupe >
DefenseSession "1" -- "0..*" StudentGroup : contient >
DefenseSession "0..*" -- "1" JuryRoleTemplate : utilise >

StudentGroup "0..*" -- "1" Project : associé à >
StudentGroup "0..*" -- "0..*" Student : membres >

User "1" -- "0..*" AppNotification : reçoit >
User "1" -- "0..*" Unavailability : déclare >
User "1" -- "0..*" AuditLog : effectue >
Student "1" -- "0..*" StudentDocument : téléverse >

JuryRoleTemplate "1" *-- "0..*" TemplateRole : définit >

' --- Layout Hints ---

RoleEnum -[hidden]right- DefenseSessionStatus
DefenseSessionStatus -[hidden]right- DefenseType
DefenseType -[hidden]right- ProjectStatus
ProjectStatus -[hidden]right- EvaluationStatus
EvaluationStatus -[hidden]right- NotificationType

User -[hidden]down- DefenseSession
DefenseSession -[hidden]right- Defense
Defense -[hidden]right- Project
Project -[hidden]down- Evaluation
Evaluation -[hidden]right- StudentDocument
StudentGroup -[hidden]right- Department

@enduml
