@startuml
!include puml-theme-pfe.puml

' --- Enums ---

enum RoleEnum {
    ADMINISTRATEUR
    COORDINATEUR
    ENSEIGNANT
    ETUDIANT
}

enum DefenseSessionStatus {
    DRAFT
    ACTIVE
    CLOSED
}

enum DefenseType {
    RATTRAPAGE
    NORMAL
}

enum DefenseStatus {
    PLANNED
    SCHEDULED
    JURY_ASSIGNED
    CONVOCATION_SENT
    IN_PROGRESS
    FINISHED
    EVALUATED
    CLOSED
    CANCELLED
}

enum DecisionEnum {
    ADMIS
    AJOURNE
}

enum NotificationStatus {
    EN_ATTENTE
    ENVOYEE
    ECHEC
}

enum ProjectType {
    PFE
    MEMOIRE
    STAGE
}

' --- Abstract User ---

abstract class User {
    + Long id
    + String nom
    + String prenom
    + String email
    + String password
    + RoleEnum role
    + Boolean actif
    + seConnecter()
    + seDeconnecter()
    + modifierProfil()
}

' --- Entity Classes ---

class DefenseSession {
    + Long id
    + String libelle
    + LocalDate dateDebut
    + LocalDate dateFin
    + Integer breakDuration
    + Map<String, Integer> evaluationCoefficients
    + DefenseSessionStatus statut
    + DefenseType defenseType
}

class Defense {
    + Long id
    + LocalDate datePassage
    + LocalTime heureDebut
    + Integer dureeMinutes
    + DefenseStatus statut
}

class Project {
    + Long id
    + String titre
    + String description
    + ProjectType type
}

class Room {
    + Long id
    + String nom
    + String batiment
    + Integer capacite
}

class Evaluation {
    + Long id
    + Double note
    + String observations
    + Boolean validee
}

class Unavailability {
    + Long id
    + LocalDate dateDebut
    + LocalDate dateFin
    + LocalTime heureDebut
    + LocalTime heureFin
    + String motif
}

class Notification {
    + Long id
    + String sujet
    + String contenu
    + NotificationStatus statut
    + LocalDateTime dateEnvoi
}

class StudentDocument {
    + Long id
    + String type
    + String cheminFichier
    + Boolean envoyee
    + LocalDateTime dateGeneration
}

class StudentGroup {
    + Long id
    + String name
    + String academicYear
}

class Department {
    + Long id
    + String nom
}

class Major {
    + Long id
    + String nom
}

class Level {
    + Long id
    + String nom
}

class Grade {
    + Long id
    + String nom
}

class GeneralSettings {
    + Long id
    + Integer defaultDefenseDuration
    + Integer defaultBreakDuration
}

class DefenseSettings {
    + Long id
    + Integer minJuryMembers
    + Integer maxDefenseDuration
}

class DocumentConfig {
    + Long id
    + String headerTemplate
    + String footerTemplate
}

class EmailConfig {
    + Long id
    + String smtpHost
    + Integer smtpPort
    + String username
}

class AuditLog {
    + Long id
    + String action
    + String entityType
    + Long entityId
    + LocalDateTime timestamp
}

class ActivationToken {
    + String token
    + LocalDateTime expiryDate
    + Boolean used
}

class ResetToken {
    + String token
    + LocalDateTime expiryDate
    + Boolean used
}

class JuryRoleTemplate {
    + Long id
    + String name
}

' --- Relationships ---

User "1" -- "0..*" Project : encadre >
User "1" -- "0..*" Unavailability : déclare >
User "1" -- "0..*" Notification : reçoit >
User "1" -- "0..*" AuditLog : effectue >

DefenseSession "1" *-- "0..*" Defense : contient >
DefenseSession "1" *-- "0..*" StudentGroup : contient >

Defense "1" -- "1" Room : se déroule dans >
Defense "1" -- "1" Project : porte sur >
Defense "1" -- "0..*" Evaluation : reçoit >
Defense "1" -- "0..*" StudentDocument : génère >

Evaluation "1" -- "1" User : saisie par >

StudentGroup "1" -- "1" Level : niveau >
StudentGroup "1" -- "1" Major : filière >

Major "1" -- "1" Department : appartient à >

' --- Layout Hints ---

RoleEnum -[hidden]right- DefenseSessionStatus
DefenseSessionStatus -[hidden]right- DefenseType
DefenseType -[hidden]right- DefenseStatus
DefenseStatus -[hidden]right- DecisionEnum
DecisionEnum -[hidden]right- NotificationStatus
NotificationStatus -[hidden]right- ProjectType

RoleEnum -[hidden]down- User

DefenseSession -[hidden]right- Defense
Defense -[hidden]right- Project
Defense -[hidden]down- Evaluation
Evaluation -[hidden]right- StudentDocument
StudentGroup -[hidden]right- Department

@enduml
